{
  "product": "MyOnline TV",
  "platformVersion": "23.0.0",
  "apiVersion": 1,
  "capabilities": [
    "live",
    "epg",
    "movies",
    "series",
    "dvr",
    "library",
    "profiles",
    "search",
    "playback",
    "remote-control",
    "multi-room"
  ],
  "clients": [
    "web-pwa",
    "android-tv"
  ],
  "rules": {
    "providerSecrets": "server-only",
    "capabilityDiscovery": "required",
    "backwardCompatibility": "API v1 clients must ignore unknown capabilities"
  },
  "stability": "long-term-platform",
  "releasePolicy": "build-install-upgrade-playback-client-tests-required",
  "costPolicy": "zero-mandatory-runtime-cost",
  "featureCompletion": "audited"
}

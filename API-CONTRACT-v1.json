{
  "product": "MyOnline TV",
  "platformVersion": "8.0.1",
  "apiVersion": 1,
  "capabilities": [
    "live",
    "epg",
    "movies",
    "series",
    "dvr",
    "library",
    "profiles",
    "search",
    "playback",
    "remote-control",
    "multi-room"
  ],
  "clients": [
    "web-pwa",
    "android-tv"
  ],
  "rules": {
    "providerSecrets": "server-only",
    "capabilityDiscovery": "required",
    "backwardCompatibility": "API v1 clients must ignore unknown capabilities"
  },
  "stability": "production-baseline"
}

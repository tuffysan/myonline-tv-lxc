{
  "product": "MyOnline TV",
  "platformVersion": "9.0.0",
  "apiVersion": 1,
  "capabilities": [
    "live",
    "epg",
    "movies",
    "series",
    "dvr",
    "library",
    "profiles",
    "search",
    "playback",
    "remote-control",
    "multi-room"
  ],
  "clients": [
    "web-pwa",
    "android-tv"
  ],
  "rules": {
    "providerSecrets": "server-only",
    "capabilityDiscovery": "required",
    "backwardCompatibility": "API v1 clients must ignore unknown capabilities"
  },
  "stability": "stable-platform-baseline",
  "releasePolicy": "feature versions require build/install/upgrade/smoke verification"
}

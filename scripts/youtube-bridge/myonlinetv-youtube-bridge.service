[Unit]
Description=MyOnline TV local YouTube resolver (experimental)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nobody
Group=nogroup
WorkingDirectory=/opt/myonlinetv/youtube-bridge
ExecStart=/opt/myonlinetv/youtube-bridge/venv/bin/python /opt/myonlinetv/youtube-bridge/server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/myonlinetv/youtube-bridge
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
